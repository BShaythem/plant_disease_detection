# Copy this file to .env and fill in the values. .env is gitignored —
# never commit real values or secrets.

# --- Hugging Face ---
# Required to download certain models (gated models or to avoid anonymous rate limits).
# Create a free read-only token at https://huggingface.co/settings/tokens.
HUGGINGFACE_TOKEN=

# --- Model Paths (used by ml/scripts/*.py and scripts/fetch_models.sh) ---
# Keep default values unless you are testing an alternative model or quantization.
VISION_MODEL_PATH=./models/vision/mobilenetv4_conv_small_fp32.onnx
LLM_MODEL_PATH=./models/llm/model.gguf
EMBEDDING_MODEL_PATH=./models/embedding/model.gguf

# --- App (Expo) ---
# Variables consumed by the React Native bundle must start with EXPO_PUBLIC_
EXPO_PUBLIC_APP_ENV=development

# --- Optional: Debugging ---
# Force rebuild/refresh of knowledge.db when the app starts, even if the bundled
# version has not changed (useful during local dev, leave empty otherwise).
EXPO_PUBLIC_FORCE_KNOWLEDGE_REFRESH=